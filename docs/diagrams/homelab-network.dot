digraph homelab {
  graph [rankdir=TB, newrank=true, compound=true, nodesep=0.3, ranksep=0.32, pad=0.25,
         fontname="Helvetica", fontsize=18, labelloc=t, bgcolor=white,
         label=<<b>Homelab network</b><br/><font point-size="11" color="#555555">Zones and VLANs, cabling, and the flows between them</font><br/> >]
  node  [shape=box, style="rounded,filled", fillcolor=white, color="#666666", penwidth=1,
         fontname="Helvetica", fontsize=11, margin="0.10,0.05"]
  edge  [color="#555555", fontname="Helvetica", fontsize=9, fontcolor="#444444", arrowsize=0.6]

  subgraph cluster_internet {
    label=<<b>Internet</b>>; fontsize=12; style="rounded,filled"; fillcolor="#f3f3f3"; color="#bbbbbb"
    remote     [label=<<b>Remote laptop</b><br/><font point-size="9">WiFiman Teleport</font>>]
    cloudflare [label=<<b>Cloudflare</b><br/><font point-size="9">public DNS, DoT resolvers</font>>]
    unifi      [label=<<b>UniFi cloud</b><br/><font point-size="9">Teleport broker, backups</font>>]
  }

  att  [label=<<b>AT&amp;T BGW320</b> + fiber ONT<br/><font point-size="9">IP passthrough: the router holds the public IPv4</font>>, fillcolor="#f3f3f3"]
  udr7 [label=<<b>Pikachu</b>, UniFi Dream Router 7<br/><font point-size="9">gateway .1 on every VLAN, DHCP, zone firewall (default deny)<br/>IPS in block mode, Region Blocking, built-in Wi-Fi AP</font>>,
        fillcolor="#e6eef8", color="#2f5f98", penwidth=1.6]

  ap [label=<<b>Squirtle</b>, U7 Pro Wall AP<br/><font point-size="9">mgmt 192.168.10.2</font>>, fillcolor="#e6eef8", color="#2f5f98"]
  sw [label=<<b>Magneton</b>, USW-Lite-16-PoE<br/><font point-size="9">mgmt 192.168.10.3</font>>, fillcolor="#e6eef8", color="#2f5f98"]

  subgraph cluster_wifi {
    label=""; style="rounded,dashed"; color="#aaaaaa"

    subgraph cluster_default {
      label=<<b>Default</b>  VLAN 1<br/><font point-size="9">192.168.0.0/24, zone Internal</font>>;
      fontsize=11; style="rounded,filled"; fillcolor="#e8f5e9"; color="#5a9e62"
      home [label=<Macs, iPhones, printer, media<br/><font point-size="9">Wi-Fi 2.4, 5, 6 GHz</font>>]
    }
    subgraph cluster_work {
      label=<<b>Work</b>  VLAN 30<br/><font point-size="9">192.168.30.0/24, zone Work</font>>;
      fontsize=11; style="rounded,filled"; fillcolor="#fff6e0"; color="#c9962b"
      work [label=<Work laptop<br/><font point-size="9">Wi-Fi 5, 6 GHz</font>>]
    }
    subgraph cluster_iot {
      label=<<b>IoT</b>  VLAN 40<br/><font point-size="9">192.168.40.0/24, zone IoT</font>>;
      fontsize=11; style="rounded,filled"; fillcolor="#fdeaea"; color="#c25b5b"
      iot [label=<Smart-home devices<br/><font point-size="9">Wi-Fi 2.4 GHz only</font>>]
    }
  }

  subgraph cluster_lab10 {
    label=<<b>Lab-Infra</b>  VLAN 10  192.168.10.0/24<br/><font point-size="9">zone Lab-Mgmt</font>>;
    fontsize=11; style="rounded,filled"; fillcolor="#e3edf9"; color="#2f5f98"

    pis      [label=<<b>blastoise</b> .10  <b>pidgeot</b> .11  <b>gengar</b> .13<br/><b>arcanine</b> .14  <b>raichu</b> .15<br/><font point-size="9">Pi 4, DietPi, Docker, idle; switch ports 1, 2, 4-6</font>>]
    nidoking [label=<<b>nidoking</b> .12, Pi 4<br/><font point-size="9">Nginx Proxy Manager<br/>*.danielfaktor.net → pve, nas, dns<br/>switch port 3</font>>]

    subgraph cluster_pve {
      label=<<b>Proxmox VE cluster POKEDEX</b><br/><font point-size="9">3× Lenovo M910Q, switch ports 13-15, VLAN 20 tagged</font>>;
      fontsize=10; style="rounded,filled"; fillcolor="#f7f9fd"; color="#7d9cc4"
      vip      [label=<<b>pve VIP</b> .9:8006<br/><font point-size="9">keepalived, moves to a healthy node</font>>, style="rounded,filled,dashed"]
      moltres  [label=<<b>moltres</b> .6>]
      zapdos   [label=<<b>zapdos</b> .7>]
      articuno [label=<<b>articuno</b> .8>]
    }

    snorlax [shape=cylinder, style=filled, fillcolor=white,
             label=<<b>snorlax</b> .5<br/><font point-size="9">Synology DS923+<br/>NFS: backups, lab logs<br/>switch ports 11+12, bonded</font>>]
  }

  subgraph cluster_lab20 {
    label=<<b>Lab-VMs</b>  VLAN 20  192.168.20.0/24<br/><font point-size="9">zone Lab-VMs, guests on the Proxmox nodes</font>>;
    fontsize=11; labelloc=b; style="rounded,filled"; fillcolor="#efe9f8"; color="#7a5aa8"

    subgraph cluster_dns {
      label=<<font point-size="9">Technitium pair: DNS 1 and 2 on every network<br/>upstream Cloudflare over DoT (853)</font>>;
      labelloc=b; style="rounded,dashed"; color="#1f8a8a"
      dns1 [label=<<b>dns1</b> .20.2<br/><font point-size="9">CT 100, primary</font>>]
      dns2 [label=<<b>dns2</b> .20.3<br/><font point-size="9">CT 101</font>>]
    }
    logs [label=<<b>logs</b> .20.4<br/><font point-size="9">VM 102, log collector<br/>router syslog in, UDP 514</font>>]
  }

  legend [shape=plaintext, style="", margin=0, label=<
    <table border="0" cellborder="0" cellspacing="2" cellpadding="1">
      <tr><td align="left" colspan="2"><font point-size="10"><b>Legend</b></font></td></tr>
      <tr><td align="left"><font point-size="12" color="#444444"><b>━━━</b></font></td><td align="left"><font point-size="9">cable (port, speed)</font></td></tr>
      <tr><td align="left"><font point-size="12" color="#777777"><b>· · · ·</b></font></td><td align="left"><font point-size="9">Wi-Fi</font></td></tr>
      <tr><td align="left"><font point-size="12" color="#777777"><b>‒ ‒ ‒</b></font></td><td align="left"><font point-size="9">guest runs on node</font></td></tr>
      <tr><td align="left"><font point-size="12" color="#7a5aa8"><b>━━━</b></font></td><td align="left"><font point-size="9">logs and backups to the NAS</font></td></tr>
      <tr><td align="left"><font point-size="12" color="#2e7d32"><b>━━━</b></font></td><td align="left"><font point-size="9">remote access</font></td></tr>
    </table>>]

  { rank=same; ap; sw }
  { rank=same; home; pis; nidoking }
  { rank=same; work; vip }
  { rank=same; iot; moltres; zapdos; articuno; snorlax }
  { rank=same; legend; dns1; dns2; logs }

  cloudflare -> att [ltail=cluster_internet, dir=none, penwidth=2, label=" 1 GbE fiber"]
  att  -> udr7 [dir=none, penwidth=2, label=" WAN, 2.5 GbE"]
  udr7 -> ap   [dir=none, penwidth=2, label="port 2, 2.5 GbE "]
  udr7 -> sw   [dir=none, penwidth=2, label=" port 3, 1 GbE"]

  ap -> home [lhead=cluster_wifi, dir=none, style=dotted, penwidth=1.4, color="#777777", label=" one SSID per VLAN\n from both APs"]
  sw -> pis  [lhead=cluster_lab10, dir=none, penwidth=2, label=" 1 GbE to\n every lab host"]

  home -> work -> iot -> legend [style=invis]
  pis -> vip [style=invis]
  nidoking -> vip [style=invis]
  vip -> zapdos [style=invis]

  moltres  -> dns1 [style=dashed, color="#888888", arrowhead=none, weight=8]
  zapdos   -> dns2 [style=dashed, color="#888888", arrowhead=none, weight=8]
  articuno -> logs [style=dashed, color="#888888", arrowhead=none, weight=8]

  articuno -> snorlax [ltail=cluster_pve, color="#7a5aa8", fontcolor="#7a5aa8", constraint=false, label="vzdump"]
  logs -> snorlax     [color="#7a5aa8", fontcolor="#7a5aa8", constraint=false, label=" NFS, nightly"]

  remote -> udr7 [color="#2e7d32", fontcolor="#2e7d32", penwidth=1.4, constraint=false, label="Teleport tunnel\n(VPN zone)"]
  unifi -> udr7  [color="#aaaaaa", style=dotted, constraint=false, arrowhead=none]
}
